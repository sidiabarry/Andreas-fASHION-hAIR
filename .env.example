# Nur Namen – Werte gehören in die Umgebungsvariablen von Vercel bzw. in eine lokale .env.local (nie einchecken).

# Öffentliche Adresse der Seite (für canonical, Sitemap, Links in E-Mails), z. B. https://www.andreasfashionhair.de
SITE_URL=

# E-Mail-Versand über Resend (https://resend.com). Ohne diese drei Werte sind Anfrage- und
# Widerrufsformular in Production abgeschaltet und es werden Telefon/E-Mail/WhatsApp angezeigt.
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO_OWNER=

# Datenbank für die Online-Kasse (Supabase, Schema: supabase/migrations/0001_init.sql). Nur serverseitig.
# Ohne diese zwei Werte (und ohne Resend) bleibt die Kasse in Production geschlossen; bestellt wird dann per Anfrage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Geheimer Schlüssel für das Hashen von IP-Adressen (Rate-Limit). Beliebige lange Zufallszeichenkette.
IP_HASH_SECRET=

# Notbremse: 1 = Online-Kasse sofort schließen (Bestellung dann per Anfrage). Datenbank, Mail, Formulare und die
# Anzeige „vergeben“ bleiben unberührt. Zum Öffnen wieder entfernen und neu deployen.
CHECKOUT_CLOSED=

# Nur lokal: Demo-Modus für `next start` (komplette Kasse mit In-Memory-Store). Auf Vercel nie setzen;
# dort ist Vorschau (VERCEL_ENV=preview) automatisch Demo; Production öffnet die Kasse mit Datenbank + Resend.
AFH_DEMO=

# Telegram (optional): jede Bestellung, Anfrage und jeder Widerruf zusätzlich als Nachricht an Andrea.
# Bot bei @BotFather anlegen → Token; dem Bot einmal schreiben, Chat-ID über
# https://api.telegram.org/bot<TOKEN>/getUpdates ablesen (message.chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kostenloser Mailversand über Gmail (statt Resend, ohne eigene Domain):
# Google-Konto → Sicherheit → 2-Faktor aktivieren → „App-Passwörter“ → 16-stelliges Passwort.
GMAIL_USER=
GMAIL_APP_PASSWORD=
