# Nur Namen – Werte gehören in die Umgebungsvariablen von Vercel bzw. in eine lokale .env.local (nie einchecken).

# Öffentliche Adresse der Seite (für canonical, Sitemap, Links in E-Mails), z. B. https://www.andreasfashionhair.de
SITE_URL=

# E-Mail-Versand über Resend (https://resend.com). Ohne diese drei Werte sind Anfrage- und
# Widerrufsformular in Production abgeschaltet und es werden Telefon/E-Mail/WhatsApp angezeigt.
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO_OWNER=

# Geheimer Schlüssel für das Hashen von IP-Adressen (Rate-Limit). Beliebige lange Zufallszeichenkette.
IP_HASH_SECRET=

# Nur lokal: Demo-Modus für `next start` (komplette Kasse mit In-Memory-Store). Auf Vercel nie setzen;
# dort ist Vorschau (VERCEL_ENV=preview) automatisch Demo und Production automatisch ohne Online-Kasse.
AFH_DEMO=
