{
  "name": "andreas-fashion-hair",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-launch.ts --ci && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./tests/loader.mjs --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "check:launch": "node scripts/check-launch.ts",
    "i18n:catalog": "node scripts/catalog-i18n/generate.mjs",
    "verify": "npm run -s lint && npm run -s typecheck && npm test --silent",
    "wt:prepare": "bash scripts/wt-prepare.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@types/nodemailer": "8.0.2",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "nodemailer": "10.3.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3"
  }
}
